# ── FedE backend configuration ────────────────────────────────────
# Copy this file to `.env` at the project root and fill in real values.
# NEVER commit the real .env (it is git-ignored).

# ── AI ─────────────────────────────────────────────────────────────
# Anthropic key powers the agentic assistant (/ask, /voice general queries).
# Without it the app degrades to offline tracking mode.
# claude-haiku-4-5 is the cheapest Claude model (kept for cost economy).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1024

# OpenAI key is only needed for Whisper STT (voice transcription); optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fedex.db

# ── Secure by Design ───────────────────────────────────────────────
# Environment: development | production. In production the app REFUSES
# to start without a real JWT_SECRET (fail-closed).
ENV=development

# Comma-separated CORS allow-list. Do NOT use "*".
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# JWT signing secret for auth tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank in local dev to auto-generate an ephemeral per-process secret.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600

# Set to false ONLY for a fully offline demo with no auth. Default: true.
REQUIRE_AUTH=true

# Per-IP rate limit (requests per window).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
